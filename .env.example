# DATA-002 Supabase runtime contract
#
# Browser-safe/user-context values. The publishable key is designed to be public and
# must always be paired with least-privilege grants + RLS on exposed tables.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Elevated server-only access is intentionally NOT wired into an application client yet.
# When a later trusted-server workflow genuinely requires it, configure the current
# Supabase secret key as a server-only environment variable. Never prefix this with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
